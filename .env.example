SHOPIFY_SHOP=your-store
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
SHOPIFY_API_VERSION=2026-07

# Meta Marketing API (Ads reporting — read-only scripts)
# Long-lived system-user token with ads_read — see docs/META_SETUP.md
META_ACCESS_TOKEN=your-meta-access-token
# WA's Ad Account (with or without act_ prefix — client normalizes)
META_AD_ACCOUNT_ID=4074524202691358
META_API_VERSION=v21.0

# Google Sheets (service account JSON — never commit the key file)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_DEFAULT_GID=1188625380

# Low-stock weekly email (variants with qty <= threshold, default 1)
LOW_STOCK_THRESHOLD=1
LOW_STOCK_EMAIL_TO=you@example.com
LOW_STOCK_EMAIL_FROM=Wear Active Alerts <alerts@yourdomain.com>
# Preferred: Resend (https://resend.com) — no extra npm package
RESEND_API_KEY=re_xxxxxxxx
# Or SMTP (requires: npm install nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Wear Active Alerts <alerts@yourdomain.com>

# Phase 4 operational daily reporting (delivery OFF by default)
REPORT_DELIVERY_ENABLED=false
REPORT_DELIVERY_CHANNEL=console
REPORT_DELIVERY_WEBHOOK_URL=
REPORT_DAILY_DAYS=7
REPORT_TIMEZONE=Asia/Karachi
# Production email via Resend (same API key as low-stock). Prefer REPORT_* ;
# falls back to LOW_STOCK_EMAIL_TO / LOW_STOCK_EMAIL_FROM if unset.
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
# Phase 5A first-party attribution foundation
# Set ATTRIBUTION_CAPTURE_STARTED_AT to the *actual* storefront go-live time
# (ISO preferred), e.g. 2026-09-08T14:37:00+05:00 — not a guessed date.
# Leave unset / placeholder until Dawn theme capture is published.
ATTRIBUTION_CAPTURE_STARTED_AT=2026-09-06
ATTRIBUTION_RETENTION_DAYS=30
# Optional alert threshold overrides (do not alter Phase 3 classifiers)
# REPORT_ALERT_MARGIN_DROP_PP=5
# REPORT_ALERT_NEGATIVE_SHOPIFY_PERSISTENCE=3
# REPORT_ALERT_META_SPEND_SPIKE_PCT=30
# REPORT_ALERT_META_SPEND_SPIKE_CPA_MULT=0.25
# REPORT_ALERT_META_CPA_DETERIORATION_PCT=25
# REPORT_ALERT_META_CPA_MIN_PURCHASES=2
# REPORT_ALERT_MAX_MEDIUM_DELIVERY=3
# REPORT_ALERT_HIGH_REMINDER_EVERY=3
# REPORT_ALERT_MEDIUM_REMINDER_EVERY=7
# REPORT_MAX_BACKFILL_DAYS=90
